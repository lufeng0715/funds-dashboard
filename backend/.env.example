# funds-dashboard backend env example. Copy to `.env` and fill in.
# `.env` is git-ignored — never commit it.

# Wind aimarket key. Sourced un-prefixed per team convention.
# DO NOT paste the value into chat / docs / commit messages.
WIND_API_KEY=<redacted>

# Optional: runtime
FUNDS_DASHBOARD_ENV=dev
FUNDS_DASHBOARD_LOG_LEVEL=INFO
FUNDS_DASHBOARD_HOST=127.0.0.1
FUNDS_DASHBOARD_PORT=8000

# Optional: database
FUNDS_DASHBOARD_DATABASE_URL=sqlite:///./funds_dashboard.db
# Postgres prod example:
# FUNDS_DASHBOARD_DATABASE_URL=postgresql+psycopg://user:pw@host:5432/funds_dashboard

# Optional: Wind CLI overrides
FUNDS_DASHBOARD_WIND_CLI_NODE_PATH=node
FUNDS_DASHBOARD_WIND_CLI_SCRIPT=/Users/lufeng/.agents/skills/wind-mcp-skill/scripts/cli.mjs

# Optional: scheduler
FUNDS_DASHBOARD_CRON_DAILY=0 17 * * MON-FRI
FUNDS_DASHBOARD_SCHEDULER_TIMEZONE=Asia/Shanghai
